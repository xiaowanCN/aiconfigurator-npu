# 统一 CLI（infer-strategy-npu）镜像：
#   以 aic-npu 容器为基地，额外安装随仓库一起提交的 msmodeling 离线 whl，
#   从而在同一环境内同时具备 aic-npu 与 msmodeling 两套能力。
#
# 构建（仓库根目录下执行，msmodeling_offline_installer/ 已在仓库内）：
#   docker build -f docker/Dockerfile.unified -t infer-strategy-npu:0.1.0 .
#
# 运行（aic-npu 分支依赖 CWD=/workspace 下的 model_configs）：
#   docker run -it -v /data/results:/workspace/results -v /data/local_models:/workspace/local_models \
#     infer-strategy-npu:0.1.0

FROM quay.io/ascend/vllm-ascend:v0.23.0.post1

WORKDIR /workspace

# ---- aic-npu 本体（model_configs 同时含 msmodeling/ 二级目录）----
COPY collector/ ./collector/
COPY tools/ ./tools/
COPY model_configs/ ./model_configs/
COPY src/ ./src/
COPY pyproject.toml README.md ./

RUN pip install --no-cache-dir -e .

# ---- msmodeling 离线 whl（随仓库提交）----
# whl 自带 Requires-Dist（torch / transformers / modelscope / salabim ...），pip 会自动解析。
# 但基础镜像里的 torch 是带 NPU 补丁的，绝不能被 PyPI 的 torch 覆盖，
# 因此先生成一条约束把 torch / torchvision 钉在镜像自带版本上：
#   - 镜像 torch 已满足 >=2.8,<=2.10 → 正常安装，其余依赖照常拉取；
#   - 镜像 torch 不在该区间 → 解析直接失败并给出明确报错，避免静默装成无 NPU 的 torch。
# *.whl 通配，换版本不用改这里；目录里只保留一个 whl
COPY msmodeling_offline_installer/*.whl ./msmodeling_offline_installer/
RUN python -c "import importlib.util as u; [print(m + '==' + __import__(m).__version__) for m in ('torch', 'torchvision') if u.find_spec(m)]" > /tmp/ms-constraints.txt \
 && cat /tmp/ms-constraints.txt \
 && pip install --no-cache-dir -c /tmp/ms-constraints.txt ./msmodeling_offline_installer/*.whl \
 && rm -f /tmp/ms-constraints.txt \
 && python -c "import torch, transformers, cli.inference.throughput_optimizer, tensor_cast.device, serving_cast.parallel_runner; print('torch', torch.__version__); print('transformers', transformers.__version__)" \
 || (echo "msmodeling install/import check failed" && exit 1)

# 离线：aic-npu 与 msmodeling 的模型配置都在 /workspace/model_configs 下随镜像提供
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    PYTHONPATH=/workspace/collector \
    INFER_STRATEGY_LOCAL_MODEL_ROOT=model_configs/msmodeling

RUN mkdir -p /workspace/data /workspace/local_models /workspace/results

CMD ["/bin/bash"]
